{
	admin off
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}

	handle_path /admin/browser/* {
		forward_auth app:8080 {
			uri /admin/api/browser/auth
			header_up -Connection
			header_up -Upgrade
		}

		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}

		reverse_proxy browser:6080
	}

	handle {
		reverse_proxy app:8080 {
			health_uri /healthz
			health_interval 15s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format json
	}
}
