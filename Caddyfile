{
	admin off
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}

	handle_path /admin/browser/* {
		forward_auth app:8080 {
			uri /admin/api/browser/auth
			header_up -Connection
			header_up -Upgrade
		}

		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}

		reverse_proxy browser:6080
	}

	handle {
		reverse_proxy app:8080 {
			# Overwrite rather than append: reverse_proxy keeps a client-supplied
			# X-Forwarded-For, and uvicorn trusts the leftmost entry, so without
			# this the caller picks their own rate-limit bucket and audit identity.
			# Behind Cloudflare, use {http.request.header.CF-Connecting-IP} instead
			# and restrict trusted_proxies to Cloudflare ranges.
			header_up X-Forwarded-For {http.request.remote.host}

			health_uri /healthz
			health_interval 15s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format json
	}
}
