{
	admin off
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
	}

	handle_path /admin/browser/* {
		forward_auth app:8080 {
			uri /admin/api/browser/auth
			header_up -Connection
			header_up -Upgrade
		}

		header {
			Cache-Control "no-store"
			Pragma "no-cache"
		}

		reverse_proxy browser:6080
	}

	handle {
		# Only accept Cloudflare's canonical client address when the direct
		# peer is one of Cloudflare's published proxy ranges. Direct callers
		# keep Caddy's socket-derived forwarding chain.
		@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		request_header @cloudflare X-Forwarded-For {http.request.header.CF-Connecting-IP}

		reverse_proxy app:8080 {
			trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22
			trusted_proxies 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20
			trusted_proxies 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13
			trusted_proxies 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
			trusted_proxies 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32
			trusted_proxies 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

			health_uri /healthz
			health_headers {
				Host {$GATEWAY_DOMAIN}
			}
			health_interval 15s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format json
	}
}
