{
  "name": "icloud-mailbox-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "predeploy": "node scripts/validate-production-config.mjs",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run test && wrangler deploy --dry-run --outdir dist",
    "db:create": "wrangler d1 create icloud-mailbox",
    "db:migrate:local": "wrangler d1 migrations apply icloud-mailbox --local",
    "db:migrate:remote": "wrangler d1 migrations apply icloud-mailbox --remote"
  },
  "dependencies": {
    "hono": "4.13.4",
    "postal-mime": "3.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
