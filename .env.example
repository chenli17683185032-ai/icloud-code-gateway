ICLOUD_GATEWAY_MASTER_KEY=replace-with-urlsafe-base64-32-byte-key
ICLOUD_GATEWAY_ADMIN_PASSWORD=replace-with-a-long-admin-password
# 仅本地 control 可开：免管理员密码。线上 edge/full 必须保持 0。
ICLOUD_GATEWAY_ADMIN_OPEN=0
ICLOUD_GATEWAY_DATA_DIR=/data
ICLOUD_GATEWAY_COOKIE_SECURE=1
# 仅 full / 本地 Docker 需要。云端 edge 不要配：Chromium 已移到本地 control。
ICLOUD_GATEWAY_CDP_URL=
# 无 Docker 本地 control：固定持久 profile 目录，例如 ~/.icloud-code-gateway/browser-profile
ICLOUD_GATEWAY_BROWSER_PROFILE_DIR=
ICLOUD_GATEWAY_HME_MAINTENANCE_SECONDS=21600
ICLOUD_GATEWAY_HME_FRESHNESS_SECONDS=3600
ICLOUD_GATEWAY_HME_RETRY_MAX_SECONDS=3600
ICLOUD_GATEWAY_PUBLIC_BASE_URL=https://codes.example.com
ICLOUD_GATEWAY_TRUSTED_HOSTS=codes.example.com
ICLOUD_GATEWAY_LOG_LEVEL=INFO
# 管理员单次创建上限；默认与硬上限均为 100。Apple 实际配额/限流仍生效。
ICLOUD_GATEWAY_ALIAS_BATCH_LIMIT=100
GATEWAY_DOMAIN=codes.example.com
BROWSER_VNC_PASSWORD=replace-with-a-long-vnc-password
BROWSER_NOVNC_PORT=6080
BROWSER_SCREEN=1440x900x24
CN_PROXY_SERVER=http://proxy.example.com:8080
CN_PROXY_USERNAME=
CN_PROXY_PASSWORD=
CN_PROXY_REQUIRED=1
# Shared-server overlay only. This file is a server-local copy derived from the
# existing payment worker proxy config; it must bind only to the private Docker network.
CN_PROXY_CONFIG_PATH=/opt/new-api/icloud-code-gateway/secrets/cn-proxy.yaml
CN_PROXY_PORT=7891
EDGE_NETWORK=app_yunbay-network

# full=单机完整模式；control=本地负责 HME 账号/session；edge=云端只做验证码查询
ICLOUD_GATEWAY_DEPLOYMENT_MODE=full
# control/edge 共用；本地 control 用它向云端 edge 注册 alias/token
ICLOUD_GATEWAY_CONTROL_PLANE_TOKEN=
# 仅 control 模式必填，例如 https://icloud.yunbay.xyz
ICLOUD_GATEWAY_EDGE_BASE_URL=
ICLOUD_GATEWAY_EDGE_SYNC_ENABLED=1
ICLOUD_GATEWAY_EDGE_TIMEOUT_SECONDS=20
